{
  "name": "ecmact",
  "version": "1.0.1",
  "description": "Dynamic components library using Vite Vanilla and Web Components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,md}\"",
    "release": "npm publish --access public"
  },
  "keywords": [
    "vite",
    "web-components",
    "dynamic-components",
    "vanilla-js",
    "shadow-dom"
  ],
  "author": "Alexandr Priadchenko",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eternalvision/ecmact.git"
  }
}
