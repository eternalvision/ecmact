{
  "name": "ecmact",
  "version": "3.0.0",
  "description": "Build embeddable widgets in plain TypeScript: isolated styles, typed attributes, one script tag. No dependencies, no compiler.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc && npm run typecheck --workspaces --if-present",
    "test": "npm run test:structure && npm run test:dom && npm run test --workspaces --if-present",
    "test:dom": "vitest run --project dom --coverage",
    "test:chromium": "node scripts/check-browsers.ts chromium && vitest run --project chromium --coverage --coverage.reportsDirectory=coverage/chromium --coverage.reportOnFailure",
    "test:firefox": "node scripts/check-browsers.ts firefox && vitest run --project firefox",
    "test:webkit": "node scripts/check-browsers.ts webkit && vitest run --project webkit",
    "test:browsers": "npm run test:chromium; c=$?; npm run test:firefox; f=$?; npm run test:webkit; w=$?; exit $((c | f | w))",
    "browsers:install": "playwright install chromium firefox webkit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "test:structure": "node scripts/check-tests.ts",
    "build:all": "npm run build && npm run build --workspaces --if-present",
    "test:template": "node scripts/check-template.mjs",
    "bench": "npm run build && node scripts/benchmark.mjs",
    "size": "node scripts/size.mjs"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "signals",
    "reactive",
    "typescript",
    "ui",
    "state-management",
    "http-client",
    "styled-components",
    "widgets"
  ],
  "author": "Alexandr Priadchenko",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.4",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eternalvision/ecmact.git"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/eternalvision/ecmact/issues"
  },
  "homepage": "https://github.com/eternalvision/ecmact#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
